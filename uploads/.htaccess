# Block execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
